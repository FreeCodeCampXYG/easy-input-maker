+  invalid.event_count = ai_keyboard::kMusicSequenceStorageEvents + 1;
+  ai_keyboard::MusicSequencePlayer bounded;
+  assert(!bounded.load(invalid));
+  invalid.event_count = 1;
+  assert(bounded.load(invalid));
+  for (const auto bad_event : {
