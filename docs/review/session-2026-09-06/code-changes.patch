+           ai_keyboard::MusicSequenceEvent{0, 0, 100, 0},
+           ai_keyboard::MusicSequenceEvent{0, 4, 101, 0},
+           ai_keyboard::MusicSequenceEvent{0, 4, 100, 2}}) {
